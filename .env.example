# TigerVNC server reachable from the Piccolo container.
# Use host.docker.internal when TigerVNC runs on the Docker host,
# or the LAN IP/hostname of the machine running TigerVNC.
PICCOLO_VNC_HOST=host.docker.internal
PICCOLO_VNC_PORT=65212

# Piccolo web UI / WebSocket port.
PICCOLO_WEB_PORT=65211

# critical | error | warning | info | debug | trace
PICCOLO_LOG_LEVEL=info

# Optional: PyPI mirror used when building the Piccolo image.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
